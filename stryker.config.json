{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "bun",
  "bun": { "timeout": 120000 },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/index.ts",
    "!src/**/*Harness.ts",
    "!src/**/*Harness.tsx"
  ],
  "tsconfigFile": "stryker-no-tsconfig.json",
  "checkers": [],
  "plugins": ["@hughescr/stryker-bun-runner"],
  "concurrency": 4,
  "timeoutMS": 10000,
  "fileLogLevel": "off",
  "ignorePatterns": [".tau", "docs", "tests/*.test.ts", "CHANGELOG.md", "dist", "coverage"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
