{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "bun test --bail" },
  "coverageAnalysis": "off",
  "dryRunTimeoutMinutes": 12,
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/index.ts",
    "!src/storeEffects.ts",
    "!src/sessionEffects.ts",
    "!src/syncEffects.ts",
    "!src/**/*Harness.ts",
    "!src/**/*Harness.tsx"
  ],
  "tsconfigFile": "stryker-no-tsconfig.json",
  "checkers": [],
  "concurrency": 4,
  "timeoutMS": 10000,
  "fileLogLevel": "off",
  "ignorePatterns": [".tau", "docs", "CHANGELOG.md", "dist", "coverage"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
